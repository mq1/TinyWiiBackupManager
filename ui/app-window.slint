import { Palette } from "std-widgets.slint";
import { Navbar } from "components/navbar.slint";
import { GameGridPage } from "game-grid-page.slint";
import { SettingsPage } from "settings-page.slint";
import { AboutPage } from "about-page.slint";
import { Page, Action } from "types.slint";
import { MyPalette } from "styling.slint";
import { Logic } from "logic.slint";
import { VerticalLine } from "components/vertical-line.slint";
import { Card } from "components/card.slint";
import { GameTablePage } from "game-table-page.slint";
import { Notifications } from "components/notifications.slint";
import { GameInfoModal } from "components/game-info-modal.slint";
import { HomebrewAppsGridPage } from "homebrew-apps-grid-page.slint";
import { HomebrewAppInfoModal } from "components/homebrew-app-info-modal.slint";
import { HomebrewAppsTablePage } from "homebrew-apps-table-page.slint";
import { OscGridPage } from "osc-grid-page.slint";
import { OscTablePage } from "osc-table-page.slint";
import { OscAppInfoModal } from "components/osc-app-info-modal.slint";
import { ConfirmationModal } from "components/confirmation-modal.slint";
import { Tooltip } from "tooltip.slint";
import { ToolboxPage } from "toolbox-page.slint";
import { ConversionQueuePage } from "conversion-queue.slint";
import { WiiloadOscAppModal } from "components/wiiload-osc-app-modal.slint";

export * from "types.slint";
export { Logic }

export component AppWindow inherits Window {
    min-width: 800px;
    min-height: 600px;
    background: MyPalette.background;
    title: Logic.drive-info.label.is-empty ? "TinyWiiBackupManager  ›  No drive selected" : "TinyWiiBackupManager  ›  \{Logic.drive-info.label}  (\{Logic.drive-info.used-gib.to-fixed(2)}/\{Logic.drive-info.total-gib.to-fixed(2)} GiB)";
    default-font-size: 14px;

    private property <Page> current-page: Page.Games;
    private property <int> current-game-i: -1;
    private property <int> current-homebrew-app-i: -1;
    private property <int> current-osc-app-i: -1;
    private property <int> game-to-scrub: -1;
    private property <int> game-to-delete: -1;
    private property <int> homebrew-app-to-delete: -1;
    private property <bool> scrubbing-all-games: false;
    private property <int> wiiloading-osc-app: -1;

    // Initialize
    Timer {
        interval: 100ms;
        running: true;

        triggered => {
            if Logic.config.theme-preference == "Light" {
                Palette.color-scheme = ColorScheme.light;
            } else if Logic.config.theme-preference == "Dark" {
                Palette.color-scheme = ColorScheme.dark;
            }
            if Palette.color-scheme == ColorScheme.dark {
                Logic.dispatch(Action.SetWindowColor, "true");
            } else {
                Logic.dispatch(Action.SetWindowColor, "false");
            }

            Logic.dispatch(Action.CacheOscContents, "false");
            Logic.dispatch(Action.CheckForUpdates, "");
            Logic.dispatch(Action.CheckMountPoint, "");

            self.running = false;
        }
    }

    HorizontalLayout {
        Navbar {
            current-page <=> current-page;
        }

        VerticalLayout {
            Rectangle {
                background: MyPalette.alternate-background;
                border-top-left-radius: 10px;
                border-width: 1px;
                border-color: MyPalette.border;

                if current-page == Page.Games && Logic.config.view-as == "Grid": GameGridPage {
                    open-info(i) => {
                        current-game-i = i;
                        Logic.dispatch(Action.LoadGameInfo, Logic.games[i].uid);
                    }
                    delete-game(i) => {
                        game-to-delete = i;
                    }
                }
                if current-page == Page.Games && Logic.config.view-as == "Table": GameTablePage {
                    open-info(i) => {
                        current-game-i = i;
                        Logic.dispatch(Action.LoadGameInfo, Logic.games[i].uid);
                    }
                    delete-game(i) => {
                        game-to-delete = i;
                    }
                }
                if current-page == Page.HomebrewApps && Logic.config.view-as == "Grid": HomebrewAppsGridPage {
                    open-info(i) => {
                        current-homebrew-app-i = i;
                    }
                    delete-app(i) => {
                        homebrew-app-to-delete = i;
                    }
                }
                if current-page == Page.HomebrewApps && Logic.config.view-as == "Table": HomebrewAppsTablePage {
                    open-info(i) => {
                        current-homebrew-app-i = i;
                    }
                    delete-app(i) => {
                        homebrew-app-to-delete = i;
                    }
                }
                if current-page == Page.Osc && Logic.config.view-as == "Grid": OscGridPage {
                    open-info(i) => {
                        current-osc-app-i = i;
                    }
                    wiiload(i) => {
                        wiiloading-osc-app = i;
                    }
                }
                if current-page == Page.Osc && Logic.config.view-as == "Table": OscTablePage {
                    open-info(i) => {
                        current-osc-app-i = i;
                    }
                    wiiload(i) => {
                        wiiloading-osc-app = i;
                    }
                }
                if current-page == Page.Toolbox: ToolboxPage {
                    scrubbing-all-games <=> scrubbing-all-games;
                }
                if current-page == Page.ConversionQueue: ConversionQueuePage { }
                if current-page == Page.Settings: SettingsPage { }
                if current-page == Page.About: AboutPage { }
            }

            if !Logic.status.is-empty: HorizontalLayout {
                VerticalLine { }

                HorizontalLayout {
                    padding: 10px;

                    Text {
                        text: Logic.status;
                    }
                }
            }
        }
    }

    if current-game-i >= 0: GameInfoModal {
        game: Logic.games[current-game-i];
        closed => {
            current-game-i = -1;
            Logic.crc32-status = "";
            Logic.current-disc-info = { };
        }
        scrub => {
            game-to-scrub = current-game-i;
        }
        checksum => Logic.dispatch(Action.Checksum, Logic.games[current-game-i].uid);
    }

    if current-homebrew-app-i >= 0: HomebrewAppInfoModal {
        app: Logic.homebrew-apps[current-homebrew-app-i];
        closed => {
            current-homebrew-app-i = -1;
        }
    }

    if current-osc-app-i >= 0: OscAppInfoModal {
        app: Logic.osc-apps[current-osc-app-i];
        closed => {
            current-osc-app-i = -1;
        }
    }

    if game-to-delete >= 0: ConfirmationModal {
        Text {
            text: "Are you sure you want to delete \{Logic.games[game-to-delete].title}?\nThis action cannot be undone.";
        }

        cancelled => {
            game-to-delete = -1;
        }
        confirmed => {
            Logic.dispatch(Action.DeleteGame, Logic.games[game-to-delete].uid);
            game-to-delete = -1;
        }
    }

    if homebrew-app-to-delete >= 0: ConfirmationModal {
        Text {
            text: "Are you sure you want to delete \{Logic.homebrew-apps[homebrew-app-to-delete].name}?\nThis action cannot be undone.";
        }

        cancelled => {
            homebrew-app-to-delete = -1;
        }
        confirmed => {
            Logic.dispatch(Action.DeleteHomebrewApp, Logic.homebrew-apps[homebrew-app-to-delete].uid);
            homebrew-app-to-delete = -1;
        }
    }

    if Logic.conversion-queue-buffer.length > 0: ConfirmationModal {
        Text {
            text: "Are you sure you want to add \{Logic.conversion-queue-buffer.length} conversions to the queue?";
        }

        for conv in Logic.conversion-queue-buffer: Text {
            text: "• \{conv.in-path}";
        }

        cancelled => Logic.dispatch(Action.ClearConversionQueueBuffer, "");
        confirmed => Logic.dispatch(Action.ConfirmConversionQueueBuffer, "");
    }

    if game-to-scrub >= 0: ConfirmationModal {
        Text {
            text: "Are you sure you want to scrub \{Logic.games[game-to-scrub].title}?\nThis action cannot be undone.";
        }

        cancelled => {
            game-to-scrub = -1;
        }
        confirmed => {
            Logic.dispatch(Action.ScrubGame, Logic.games[game-to-scrub].uid);
            game-to-scrub = -1;
            current-game-i = -1;
            Logic.crc32-status = "";
            Logic.current-disc-info = { };
        }
    }

    if scrubbing-all-games: ConfirmationModal {
        Text {
            text: "Are you sure you want to scrub all games?\nThis action cannot be undone.";
        }

        cancelled => {
            scrubbing-all-games = false;
        }
        confirmed => {
            Logic.dispatch(Action.ScrubAllGames, "");
            scrubbing-all-games = false;
        }
    }

    if wiiloading-osc-app >= 0: WiiloadOscAppModal {
        app: Logic.osc-apps[wiiloading-osc-app];
        closed => {
            wiiloading-osc-app = -1;
        }
    }

    if Logic.notifications.length > 0: Notifications {
        x: root.width - self.width;
        y: root.height - self.height;
    }

    if !Tooltip.text.is-empty: Card {
        x: Tooltip.mouse-x + t.preferred-width + 18px > root.width ? Tooltip.mouse-x - t.preferred-width - 18px : Tooltip.mouse-x;
        y: Tooltip.mouse-y;

        width: t.preferred-width + 18px;
        height: t.preferred-height + 16px;

        HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 9px;
            padding-right: 9px;

            t := Text {
                text: Tooltip.text;
            }
        }
    }
}
