FROM quay.io/pypa/manylinux2014_x86_64

RUN yum install glibc-devel.i686 libgcc.i686 -y

RUN manylinux-install-clang -v 23.1.3.0

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    --yes \
    --quiet \
    --no-modify-path \
    --profile minimal \
    --default-toolchain 1.99 \
    --component rust-src

COPY --from=ghcr.io/casey/just:latest /just /usr/local/bin/

ADD https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-i686.AppImage /usr/local/bin/appimagetool
RUN chmod +x /usr/local/bin/appimagetool

ENV APPIMAGE_EXTRACT_AND_RUN=1
