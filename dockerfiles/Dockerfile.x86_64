FROM quay.io/pypa/manylinux2014_x86_64

RUN manylinux-install-clang -v 23.1.3.0

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

COPY --from=rust:1.99-slim /usr/local/rustup /usr/local/rustup
COPY --from=rust:1.99-slim /usr/local/cargo /usr/local/cargo
RUN rustup component add rust-src

COPY --from=ghcr.io/casey/just:latest /just /usr/local/bin/

ADD https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage /usr/local/bin/appimagetool
RUN chmod +x /usr/local/bin/appimagetool

ENV APPIMAGE_EXTRACT_AND_RUN=1
